# ============================================================
#  Strategy App — Environment Configuration
# ============================================================
# Copy to `.env` and fill in your keys. Anything left blank will
# fall back to sensible defaults (mock mode if no LLM key).

# ---- LLM ----
# Provider: openai | kimi | zhipu
LLM_PROVIDER=openai
# OpenAI: leave OPENAI_BASE_URL empty
# Kimi:   OPENAI_BASE_URL=https://api.moonshot.cn/v1
# Zhipu:  OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# ---- News providers ----
# Free tier: https://site.financialmodelingprep.com/
FMP_API_KEY=
# Free tier: https://cryptopanic.com/developers/api/
CRYPTOPANIC_AUTH_TOKEN=

# ---- Behaviour flags ----
# When true, all external calls are stubbed by fixtures so the demo runs
# end-to-end without any keys (useful for first-time setup).
USE_MOCK=true

# Cache time-to-live, in minutes (default 6h). Lower = fresher / more LLM cost.
CACHE_TTL_MINUTES=360

# Max number of cards returned per /feed call.
DEFAULT_FEED_LIMIT=20

# ---- Server ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8088
